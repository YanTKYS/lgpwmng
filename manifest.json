{
  "manifest_version": 3,
  "name": "lgpwmng",
  "version": "0.6.0",
  "description": "業務システムのログイン入力補助。任意の入力項目と複数アカウントに対応。認証情報は端末内に暗号化して保存し、外部通信は行いません。",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "lgpwmng",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
